<!-- indexer::stop -->
<?php
/**
 * Ausgabetemplate mit Verlaufsdiagrammen.
 *
 * Die Diagramme sind fertiges SVG vom Server. Bis Fassung 1.2.9 lieferte die
 * Erweiterung dafür Datenreihen für die Javascript-Bibliothek „flot“ — die
 * Pfade dorthin zeigten seit dem Wechsel auf Contao 4 ins Leere, die
 * Diagramme blieben also leer. jQuery wird nicht mehr benötigt.
 */
?>
<div class="fhcounter_diagramme <?= $this->class ?> block"<?= $this->cssID ?><?php if ($this->style): ?> style="clear:both; <?= $this->style ?>"<?php endif; ?>>

	<?php if ($this->headline): ?>
		<<?= $this->hl ?>><?= $this->headline ?></<?= $this->hl ?>>
	<?php endif; ?>

	<?php if ($this->ViewCounterinfo): ?>
		<ul class="fhcounter_infos">
			<li>Zählerquelle: <b><?= $this->CounterSource ?></b></li>
			<li>ID der Quelle: <b><?= $this->CounterPid ?></b></li>
			<li>Erste Zählung: <b><?= date('d.m.Y H:i', (int) $this->CounterStarttime) ?></b></li>
			<li>Gesamtzugriffe: <b><?= $this->CounterTotalhits ?></b></li>
			<li>Letzte Zählung: <b><?= date('d.m.Y H:i', (int) $this->CounterLastcounting) ?></b></li>
			<li>Letzter Besucher: <b><?= $this->CounterLastip ?></b></li>
			<li>Besucher online: <b><?= $this->CounterOnline ?></b></li>
		</ul>
	<?php endif; ?>

	<?php if ($this->ViewDiagrams): ?>
		<div class="fhcounter-container">
			<h2>Zugriffe letzte <?= $this->CounterHoursValues ?> Stunden</h2>
			<?= $this->CounterHoursChart ?>
		</div>

		<div class="fhcounter-container">
			<h2>Zugriffe letzte <?= $this->CounterDaysValues ?> Tage</h2>
			<?= $this->CounterDaysChart ?>
		</div>

		<div class="fhcounter-container">
			<h2>Zugriffe letzte <?= $this->CounterMonthsValues ?> Monate</h2>
			<?= $this->CounterMonthsChart ?>
		</div>
	<?php endif; ?>

</div>
<!-- indexer::continue -->

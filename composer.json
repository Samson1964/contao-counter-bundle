{
    "name": "schachbulle/contao-counter-bundle",
    "type": "contao-bundle",
    "description": "Zählt die Zugriffe auf Seiten, Artikel und Nachrichten und gibt die Zahlen im Frontend aus.",
    "keywords": [
        "contao",
        "zähler",
        "statistik",
        "zugriffe"
    ],
    "homepage": "https://github.com/Samson1964/contao-counter-bundle",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Frank Hoppe",
            "homepage": "https://www.schachbulle.de/"
        }
    ],
    "require": {
        "php": ">=5.6",
        "contao/core-bundle": "^4",
        "contao/news-bundle": "*",
        "schachbulle/contao-helper-bundle": "*"
    },
    "conflict": {
        "contao/core": "*",
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0",
        "doctrine/doctrine-cache-bundle": "^1.3"
    },
    "extra": {
        "contao-manager-plugin": "Schachbulle\\ContaoCounterBundle\\ContaoManager\\Plugin"
    },
    "autoload": {
        "psr-4": {
            "Schachbulle\\ContaoCounterBundle\\": "src/"
        }
    },
    "support": {
        "issues": "https://github.com/Samson1964/contao-counter-bundle/issues",
        "source": "https://github.com/Samson1964/contao-counter-bundle"
    }
}
